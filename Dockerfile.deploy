# syntax=docker/dockerfile:1.7
FROM rust:1.97-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential clang cmake libssl-dev libdbus-1-dev libudev-dev pkg-config ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && rustup target add wasm32v1-none

RUN --mount=type=cache,target=/usr/local/cargo/registry \
  --mount=type=cache,target=/usr/local/cargo/git \
  --mount=type=cache,target=/opt/cargo-target \
  CARGO_TARGET_DIR=/opt/cargo-target cargo install --locked stellar-cli --version 27.0.0

WORKDIR /workspace
ENTRYPOINT ["/workspace/deploy-testnet-docker.sh"]
